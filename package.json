{
  "name": "chikku-parser",
  "version": "0.3.13",
  "description": "Desktop app for viewing, combining, and transforming CSV data",
  "scripts": {
    "clean": "rimraf dist-tauri",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "tauri:assets": "mkdirp dist-tauri && recursive-copy -w html/index.html dist-tauri/index.html && recursive-copy -w html/icon.svg dist-tauri/icon.svg",
    "tauri:renderer:build": "npm run tauri:assets && webpack --env tauri --mode production",
    "tauri:renderer:watch": "npm run tauri:assets && webpack serve --env tauri --mode development",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "keywords": [
    "csv",
    "data",
    "combiner",
    "viewer",
    "tauri",
    "duckdb"
  ],
  "author": "Abin Jacob <aj4abinjacob@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@blueprintjs/core": "^4.20.2",
    "@blueprintjs/icons": "^4.16.0",
    "@blueprintjs/popover2": "^1.14.1",
    "@tanstack/react-virtual": "^3.13.19",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "chrono-node": "^2.9.0",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "css-loader": "^6.10.0",
    "file-loader": "^6.2.0",
    "less": "^4.2.0",
    "less-loader": "^12.2.0",
    "mini-css-extract-plugin": "^2.10.2",
    "mkdirp": "^3.0.1",
    "recursive-copy-cli": "^1.0.20",
    "resolve-url-loader": "^5.0.0",
    "rimraf": "^5.0.5",
    "sass": "^1.80.0",
    "sass-loader": "^14.2.0",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.4.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.4"
  }
}
